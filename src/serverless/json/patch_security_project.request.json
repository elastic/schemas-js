{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "patchSecurityProject",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The ID of the project",
      "x-found-in": "path"
    }
  },
  "required": [
    "id"
  ],
  "allOf": [
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "alias": {
          "type": "string"
        },
        "admin_features_package": {
          "oneOf": [
            {
              "enum": [
                "standard",
                "enterprise"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "product_types": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "product_line": {
                    "enum": [
                      "security",
                      "cloud",
                      "endpoint"
                    ]
                  },
                  "product_tier": {
                    "enum": [
                      "complete",
                      "essentials"
                    ]
                  }
                },
                "required": [
                  "product_line",
                  "product_tier"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "search_lake": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "data_retention": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "max_retention_days": {
                          "oneOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "default_retention_days": {
                          "oneOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "traffic_filters": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "type": "object",
          "properties": {
            "tags": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "required": [
            "tags"
          ]
        },
        "linked": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "projects": {
                  "type": "object",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "enum": [
                              "elasticsearch",
                              "observability",
                              "security",
                              "vectordb"
                            ]
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  ]
}