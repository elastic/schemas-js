{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "createObservabilityProject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "alias": {
      "type": "string"
    },
    "region_id": {
      "type": "string"
    },
    "traffic_filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "product_tier": {
      "enum": [
        "complete",
        "logs_essentials"
      ]
    },
    "linked": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "elasticsearch",
                  "observability",
                  "security",
                  "vectordb"
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "projects"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "tags"
      ]
    }
  },
  "required": [
    "name",
    "region_id"
  ],
  "additionalProperties": false
}