{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"cat.health__HealthRecord":{"type":"object","properties":{"epoch":{"$ref":"./_spec_utils.json#/$defs/_spec_utils__Stringified","description":"seconds since 1970-01-01 00:00:00"},"timestamp":{"type":"string","description":"time in HH:MM:SS"},"cluster":{"type":"string","description":"cluster name"},"status":{"type":"string","description":"health status"},"node.total":{"type":"string","description":"total number of nodes"},"node.data":{"type":"string","description":"number of nodes that can store data"},"shards":{"type":"string","description":"total number of shards"},"pri":{"type":"string","description":"number of primary shards"},"relo":{"type":"string","description":"number of relocating nodes"},"init":{"type":"string","description":"number of initializing nodes"},"unassign.pri":{"type":"string","description":"number of unassigned primary shards"},"unassign":{"type":"string","description":"number of unassigned shards"},"pending_tasks":{"type":"string","description":"number of pending tasks"},"max_task_wait_time":{"type":"string","description":"wait time of longest task pending"},"active_shards_percent":{"type":"string","description":"active number of shards in percent"}}}}}